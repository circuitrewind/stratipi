# EFI VARIABLES FROM SD CARD
CONFIG_ENV_FAT_DEVICE_AND_PART=""
CONFIG_ENV_IS_IN_FAT=y
CONFIG_EFI_VARIABLE_FILE_STORE=y
CONFIG_FAT_WRITE=y

# BOOT STUFF
CONFIG_RPI_EFI_NR_SPIN_PAGES=2

# AUTOBOOT LOGIC
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Autobooting in %d seconds, press \"<Esc>\" to stop\n"
CONFIG_AUTOBOOT_STOP_STR="\x1b"
CONFIG_AUTOBOOT_DELAY_STR=""

# HDMI MUX CONSOLE OVERRIDES (Bypasses Kconfig dependency tracking)
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_SYS_DEVICE_NULLDEV=y

# DYNAMIC RESOLUTION FIX WITH 32-BIT COLOR INVERSION 
# Passing just 'video=le:1' forces the 32-bit byte swap while inheriting config.txt resolution
CONFIG_PREBOOT="setenv videomode video=le:1; setenv stdout vidconsole,nulldev; setenv stderr vidconsole,nulldev; setenv stdin usbkbd,nulldev; bcm2835_video_probe"

# DISABLE UART DEBUG BROADCASTS
CONFIG_DEBUG_UART_SKIP_INIT=y
